# Copy to .env (git-ignored) and fill in. Read only by the Voice Studio server.
# The base URL and key can also be entered in the app's Settings page; those are saved to
# studio/data/settings.json (mode 600) and take precedence over this file.

# Utilities API root. The /docs page address also works; it is trimmed to the root.
UTILS_BASE_URL=https://your-utilities-gateway.example.com
UTILS_API_KEY=

# Optional
# UTILS_VIDEO_LOCATION=us-central1          # Vertex region that serves Veo through the gateway
# STUDIO_TRANSCRIBE_MODEL=gemini-2.5-flash  # model used (via /llm/generate) to transcribe speech
# STUDIO_DEVICE=auto                        # Chatterbox device: auto | mps | cpu | cuda:0
# STUDIO_DATA_DIR=studio/data               # projects, history database, voices

# Provider-call gate: off by default. Set to "on" to allow model listing and video generation.
# STUDIO_PROVIDER_CALLS=on
